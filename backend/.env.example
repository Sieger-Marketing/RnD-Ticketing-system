# ---------------------------------------------------------------------------
# Design Operations & Ticketing Management System - backend configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres. Local development points at the Postgres instance on this machine.
DATABASE_URL=postgresql+psycopg://designops:CHANGE_ME@127.0.0.1:5432/designops

# Auth. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage. Provider is swappable: local | s3 | azure | salesforce
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=../storage

# Email. Provider is swappable: console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=designops@example.com

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Seeding
SEED_DEFAULT_PASSWORD=Design@123
