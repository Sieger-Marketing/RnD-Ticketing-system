# Where the API lives.
#
# Left empty, the client calls same-origin "/api", which is what you want in
# development (Vite proxies it) and in production behind a Vercel rewrite.
# Set it only when the API is on a different origin with CORS configured.
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
VITE_API_TARGET=http://127.0.0.1:8000
