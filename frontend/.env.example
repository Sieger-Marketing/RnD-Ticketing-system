# Where the API lives.
#
# Left empty the client calls same-origin "/api", which is what you want in
# development (Vite proxies it). In production the API is on Render, a
# different origin, so this must be set at BUILD time -- Vite bakes VITE_*
# values into the bundle, it does not read them at runtime.
#
# Production value:
#   VITE_API_BASE_URL=https://rnd-ticketing-system.onrender.com
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
VITE_API_TARGET=http://127.0.0.1:8000
