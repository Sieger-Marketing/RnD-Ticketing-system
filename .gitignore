# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.vite/

# Secrets & local state
.env
.env.local
# Any other .env variant is assumed to hold secrets. The two that do not --
# the checked-in example and the build-time frontend config -- are readmitted
# explicitly, so a new .env.something is ignored by default rather than
# committed by accident.
.env*
!.env.example
!frontend/.env.production
*.local

# Uploaded files
storage/
!storage/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local dev logs
*.log

# Generated credentials. Handed out once and deleted; never committed.
initial-passwords*.csv

# Service logs and database dumps produced on the machine that hosts this.
# The dumps are the department's entire dataset; they must never be committed.
logs/
backups/
*.dump

# TypeScript incremental build cache.
*.tsbuildinfo
